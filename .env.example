# =============================================================================
# ENVIRONMENT VARIABLES - DevResource (Instagram Creator AI Resource Hub)
# Copy this file to ".env.local" or ".env" and fill in your credentials.
# All features fall back to safe mocked/local operation if keys are omitted.
# =============================================================================

# -----------------------------------------------------------------------------
# Base App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Creator Profile Overrides
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CREATOR_HANDLE="creator_handle"
NEXT_PUBLIC_CREATOR_NAME="AI & Tech Creator"

# -----------------------------------------------------------------------------
# Meta Account Linkage & Instagram Graph API Plugin
# Get these from: developers.facebook.com -> Your App -> App Settings / Webhooks
# -----------------------------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="your_secure_random_token_here"
META_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# -----------------------------------------------------------------------------
# Storage Providers (Google Drive & Cloudflare R2)
# -----------------------------------------------------------------------------
DEFAULT_STORAGE_PROVIDER="drive" # "drive" or "r2"
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_DOMAIN=""

# -----------------------------------------------------------------------------
# Supabase (Optional - Server-side cloud analytics sync)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
