{
  "name": "insta-resource-hub",
  "version": "2.0.0",
  "private": true,
  "description": "Instagram Creator AI Resource Hub & Campaign Analytics - Next.js edition",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "resource:cli": "node scripts/resource-manager.mjs",
    "plugins:list": "node scripts/plugins-runner.mjs list",
    "plugins:test": "node scripts/plugins-runner.mjs test",
    "docker:build": "docker build -t devresource:latest .",
    "docker:run": "docker run -p 3000:3000 --name devresource --rm devresource:latest",
    "docker:compose:up": "docker compose up -d --build",
    "docker:compose:down": "docker compose down",
    "docker:compose:logs": "docker compose logs -f web",
    "vercel:build": "next build"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
